rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerUserId() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function createsAsOwner() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function updatesAsOwner() {
      return isOwnerUserId()
        && request.resource.data.userId == request.auth.uid;
    }

    match /expenses/{expenseId} {
      allow read: if isOwnerUserId();
      allow create: if createsAsOwner();
      allow update: if updatesAsOwner();
      allow delete: if isOwnerUserId();
    }

    match /categories/{categoryId} {
      allow read: if isOwnerUserId();
      allow create: if createsAsOwner();
      allow update: if updatesAsOwner();
      allow delete: if isOwnerUserId();
    }

    match /trades/{tradeId} {
      allow read: if isOwnerUserId();
      allow create: if createsAsOwner();
      allow update: if updatesAsOwner();
      allow delete: if isOwnerUserId();
    }

    match /userSettings/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}